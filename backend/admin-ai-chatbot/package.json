{
  "name": "eatomo-admin-ai-chatbot",
  "version": "1.0.0",
  "private": true,
  "description": "Admin AI Chatbot workspace for dataset generation, ML training, and serving predictions.",
  "main": "src/api/server.js",
  "scripts": {
    "dataset:build": "node scripts/build_dataset.js --synthetic=5000",
    "dataset:small": "node scripts/build_dataset.js --synthetic=1000",
    "train:baseline": "node scripts/train_baseline.js --target=cancel",
    "train:cancel": "node scripts/train_baseline.js --target=cancel",
    "train:delay": "node scripts/train_baseline.js --target=delay",
    "train:all": "node scripts/train_all.js",
    "serve:model": "node src/api/server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mongoose": "^8.5.0"
  }
}
