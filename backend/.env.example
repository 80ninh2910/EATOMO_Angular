MONGO_URI=mongodb://localhost:27017/eatomo_db
JWT_SECRET=replace_with_secure_random_secret
JWT_EXPIRES_IN=7d
PORT=3000
OPENAI_API_KEY=replace_with_valid_openai_or_gemini_key
OPENAI_MODEL=gpt-4o-mini

# Password reset email via HTTPS API (recommended for Render free services)
RESEND_API_KEY=replace_with_resend_api_key
MAIL_FROM=EATOMO <no-reply@example.com>

# Password reset email via SMTP fallback (optional; Render free services may block SMTP ports)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_password
SMTP_FROM=EATOMO <no-reply@example.com>
SMTP_TIMEOUT_MS=10000
SMTP_FAMILY=4
RESET_OTP_DEBUG=false

# Firebase Cloud Messaging (optional, required for push notifications)
FIREBASE_PROJECT_ID=replace_with_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
